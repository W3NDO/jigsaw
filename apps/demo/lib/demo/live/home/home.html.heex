<Layouts.flash_group flash={@flash} />
<div class="w-full flex flex-col" phx-window-keydown="jigsaw-key-shortcuts">
  <!-- Wallpaper -->
  <img src="images/jigsaw_background.jpg" class="h-dvh w-dvw brightness-30 absolute top-0 -z-99" />
  
<!-- Top bar -->
  <div class="absolute inset-x-0 top-0 z-50 h-[3dvh] min-h-7 border-b border-white/10 bg-gray-950/85 px-4 shadow-sm backdrop-blur">
    <ul class="grid h-full grid-cols-3 items-center text-xs font-medium">
      <!-- Clock -->
      <li id="clock" class="justify-self-start text-gray-300" phx-update="ignore">
        --:--
      </li>
      
<!-- Application -->
      <li class="justify-self-center tracking-wide uppercase text-white">
        {@focused || "JIGSAW"}
      </li>
      
<!-- Battery -->
      <li class="flex items-center gap-1.5 justify-self-end text-gray-300">
        <.icon name="hero-user" class="size-4" />
        <span>DEMO USER</span>
      </li>
    </ul>
  </div>
  
<!-- Bottom navbar -->
  <div class="w-[50vw] p-1 m-auto border rounded-full border-slate-500 absolute left-[25vw] bottom-10 z-10 hover:bg-gray-950/85">
    <div class="flex justify-around">
      <ul class="flex justify-between">
        <%= for pane <- @available_panes_id do %>
          <li>
            <button phx-click="toggle-pane" phx-value-pane={pane} class="m-1 rounded-md px-2 ">
              <div
                class={"rounded-sm hover:border-b hover:border-slate-500 #{if Enum.member?(@active_panes, pane), do: "border-t border-slate-500", else: "border-transparent"} "}
                title={"#{pane}. CTRL+#{Enum.find_index(@available_panes_id, &(&1 == pane))+1}"}
              >
                <%= case pane do %>
                  <% "terminal" -> %>
                    <div title="CTRL+1"><.icon name="hero-command-line" class="size-10" /></div>
                  <% "music" -> %>
                    <div title="CTRL+2"><.icon name="hero-play" class="size-10" /></div>
                  <% "about" -> %>
                    <div title="CTRL+3">
                      <.icon name="hero-information-circle" class="size-10" />
                    </div>
                <% end %>
              </div>
            </button>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="absolute top-[3dvh] h-[96vh] min-h-[96dvh] w-full">
    <div class="h-full w-full">
      <JigsawComponents.Components.layout jigsaw_layout={@jigsaw_layout}>
        <:pane id="terminal" focused={@focused == "terminal"}>
          <Live.Home.Component.Terminal.terminal />
        </:pane>

        <:pane id="music" focused={@focused == "music"}>
          <Live.Home.Component.Music.music />
        </:pane>

        <:pane id="about" focused={@focused == "about"}>
          <Live.Home.Component.About.about />
        </:pane>
      </JigsawComponents.Components.layout>
    </div>
  </div>
</div>

<script>
  function updateClock() {
    const clock = document.getElementById("clock");

    if (!clock) return;

    const now = new Date();

    clock.textContent = now.toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false
    });
  }

  updateClock();
  setInterval(updateClock, 1000);

  const terminal = document.getElementById("terminal_component")
  const input = document.getElementById("terminal-input")
  const output = document.getElementById("terminal-output")

  if (terminal && input && output) {
    const commands = {
      help: () => [
        "Available commands:",
        "",
        "  help     Show available commands",
        "  about    About Jigsaw"
      ],

      about: () => [
        "Jigsaw",
        "",
        "A proof of concept tiling library for Phoenix applications.",
        "Built with Elixir and Phoenix LiveView."
      ]
    }

    function writeLine(text, className = "") {
      const line = document.createElement("div")
      line.className = className
      line.textContent = text
      output.insertBefore(line, input.parentElement)
    }

    input.addEventListener("keydown", event => {
      if (event.key !== "Enter") return

      const command = input.value.trim().toLowerCase()

      if (!command) return

      // Show entered command
      writeLine(`$ ${command}`, "text-gray-300")

      input.value = ""

      if (commands[command]) {
        commands[command]().forEach(line => {
          writeLine(line, "text-gray-400")
        })
      } else {
        writeLine(`Command not found: ${command}`, "text-red-400")
        writeLine("Type 'help' for available commands.", "text-gray-500")
      }

      output.scrollTop = output.scrollHeight
    })
  }
</script>
